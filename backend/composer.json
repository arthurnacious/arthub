{
    "name": "arthub/backend",
    "description": "Arthub backend API - clients, projects, quotes and invoices",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "hyperdrive/framework": "@dev",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
