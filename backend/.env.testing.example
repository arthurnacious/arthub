# Copy to .env.testing and fill in real values. Tests always load this
# file (see tests/bootstrap.php), never .env, so the real dev database
# is never touched by the test suite. Point DB_DATABASE at a separate
# database (e.g. "arthub_test") - the test bootstrap runs migrations
# against it automatically, and every test runs inside a transaction
# that's rolled back afterwards, but a dedicated database still keeps
# test runs from ever colliding with real dev/admin data.

APP_ENV=testing

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arthub_test
DB_USERNAME=postgres
DB_PASSWORD=

JWT_SECRET=testing-secret-not-used-in-production
