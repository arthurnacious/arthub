#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../bootstrap.php';

use App\Console\Commands\MakeMigrationCommand;
use App\Console\Commands\MigrateCommand;
use App\Console\Commands\MigrateRollbackCommand;
use App\Console\Commands\SeedCommand;
use App\Console\Commands\StorageLinkCommand;
use App\Database\Connection;
use App\Database\Migrator;
use Symfony\Component\Console\Application;

// Commands are wired up by hand here rather than through Hyperdrive's
// container: Migrator and MakeMigrationCommand both take a plain string
// path, which the container can't autowire (it only resolves typed
// class/interface constructor parameters).
$connection = new Connection();
$migrationsPath = __DIR__ . '/../database/migrations';
$migrator = new Migrator($connection, $migrationsPath);

$application = new Application('Arthub CLI', '0.1.0');
$application->addCommands([
    new MigrateCommand($migrator),
    new MigrateRollbackCommand($migrator),
    new MakeMigrationCommand($migrationsPath),
    new SeedCommand($connection),
    new StorageLinkCommand(dirname(__DIR__)),
]);

exit($application->run());
