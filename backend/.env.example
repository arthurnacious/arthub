# Copy this file to .env and fill in real values. .env is gitignored.

APP_ENV=development
APP_URL=http://localhost:9501

# Origin of the TanStack Start frontend, for CORS.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Postgres - create a role + database matching these before running
# `bin/console migrate`. Defaults below assume a local Postgres with a
# database called "arthub" owned by a role called "arthub".
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arthub
DB_USERNAME=arthub
DB_PASSWORD=

# Used once by `bin/console db:seed` to create the very first admin user.
# Change the password after first login - this is only a bootstrap value.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-immediately

# JWT signing secret for the admin/client login tokens (Hyperdrive's
# JwtService reads this via auth.jwt.secret, see config/auth.php).
JWT_SECRET=change-me-to-a-long-random-string

# SMTP settings for PHPMailer. Any SMTP provider works (Mailtrap is a good
# choice for local dev - it captures mail instead of really sending it).
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@arthub.test
MAIL_FROM_NAME=Arthub
