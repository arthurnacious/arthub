# Arthub server configuration.
# Copy to .env (`cp .env.example .env`). The server loads .env from the
# directory it's started in; real environment variables take precedence.
# Empty values count as unset.

# ── Runtime ─────────────────────────────────────────────────────────────
# PROD (or production): secure cookies, https origins, and the server refuses
# to start without a working email config. Leave unset for development.
#LEPTOS_ENV=PROD

# Listen address. Default 127.0.0.1:3000; 0.0.0.0 makes it reachable on the LAN.
#LEPTOS_SITE_ADDR=0.0.0.0:3000
# Path to the built site folder (target/site in the repo, `site` in the image).
#LEPTOS_SITE_ROOT=target/site
# Must match the name in Cargo.toml's [workspace.metadata.leptos].
#LEPTOS_OUTPUT_NAME=arthub

# Public origin for canonical links, share images and the sitemap.
# Unset: derived from the request's Host header.
#SITE_URL=https://arthub.dev

# Set to 1 behind Fly/Railway/nginx so per-IP rate limits use X-Forwarded-For.
# Don't set it when clients connect directly: they could spoof their IP.
#TRUST_PROXY=1

# Where the SQLite database (arthub.db) and dashboard uploads live.
DATA_DIR=data

# The only address allowed to sign in to /admin (magic link by email).
# Unset: nobody can sign in.
#ADMIN_EMAIL=you@example.com

# Log filter. Default: info,server=info,contact=info
#RUST_LOG=info

# ── Email (contact form + admin sign-in links) ──────────────────────────
# With nothing configured, development prints each email to the console
# instead of sending it.

# Where enquiries go (your inbox).
CONTACT_TO=you@example.com
# Sender address, on a domain your provider lets you send as.
CONTACT_FROM=hello@example.com

# smtp | resend | postmark | log. Optional: inferred as smtp if SMTP_HOST is
# set, else resend if EMAIL_API_KEY is set, else log (development only).
#EMAIL_PROVIDER=smtp

# Option A: SMTP. Port 587 = STARTTLS (default), 465 = implicit TLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=

# Option B: API. A Resend API key, or a Postmark server token with
# EMAIL_PROVIDER=postmark.
#EMAIL_API_KEY=
