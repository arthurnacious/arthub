# Build output: cargo, cargo-leptos (target/site) and the room build (target/room).
/target/

# Local config. May hold SMTP passwords or API keys; .env.example is the
# committed template.
.env
.env.*
!.env.example

# Runtime data: the SQLite database (seeded from content/ on first run) and
# dashboard uploads. Location set by DATA_DIR.
/data/

# Game room WASM bundle. Regenerated by `just build-room` (the Dockerfile and
# `just build`/`just dev` run it), so it isn't committed.
/assets/room/bundle/

# Source textures downloaded by `just fetch-textures` (CC0, not redistributed
# here). The baked KTX2 files in assets/room/tex/ are committed instead.
/art/

# Room screenshots written by `just tour`.
/target/tour/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
