# Copy this file to .env and fill in real values. .env is gitignored.
# Vite only exposes variables prefixed with VITE_ to browser code - see
# https://vite.dev/guide/env-and-mode.html.

# Human-facing app name, shown in the browser tab title etc.
VITE_SITE_NAME=Arthub

# Base URL of the arthub backend (see ../backend/.env.example APP_URL) -
# where the frontend sends its API requests.
VITE_API_URL=http://localhost:9501
